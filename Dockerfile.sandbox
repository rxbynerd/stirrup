# syntax=docker/dockerfile:1.7

# Sandbox image for agent workloads: the image (`executor.image`) the
# container, k8s, and k8s-sandbox executors run commands in. Distinct from
# ./Dockerfile (the distroless harness image), which ships no shell and
# cannot satisfy the executors' requirements. Everything an image must
# provide is stated in docs/executors/image-contract.md; this image meets
# every entry. Debian slim already carries the shell and coreutils; git
# and ca-certificates are added so agents can operate on checkouts and
# fetch over HTTPS.
FROM debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

# Every executor runs the sandbox as 65532:65532 (the distroless
# "nonroot" convention) and sets HOME and TMPDIR under its /scratch
# mount, so the passwd entry only names the identity.
RUN groupadd --gid 65532 nonroot \
    && useradd --uid 65532 --gid 65532 --no-create-home --home-dir /scratch/home --shell /bin/sh nonroot

# The executors exec as a fixed non-root UID that generally does not own
# the mounted workspace (the container executor bind-mounts a host
# directory that keeps host ownership), and git refuses to operate on a
# repository owned by another UID ("dubious ownership"). The whole
# filesystem is a single-purpose sandbox, so the ownership check
# protects nothing here.
RUN git config --system safe.directory '*'

USER 65532:65532

# The executors override the command with their own `sleep`; this default
# keeps ad-hoc `docker run` inspection usable.
CMD ["sleep", "infinity"]
