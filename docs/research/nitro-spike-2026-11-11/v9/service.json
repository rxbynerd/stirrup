{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "stirrup-egress-proxy",
    "namespace": "nitro-spike",
    "labels": {
      "nitro-spike-owned": "true"
    }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": {
      "app": "stirrup-egress-proxy"
    },
    "ports": [
      {
        "name": "proxy",
        "port": 8080,
        "targetPort": "proxy"
      }
    ]
  }
}