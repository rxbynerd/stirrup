{
  "apiVersion": "networking.k8s.io/v1",
  "kind": "NetworkPolicy",
  "metadata": {
    "name": "nitro-v9-allowlist",
    "namespace": "nitro-spike",
    "labels": {
      "nitro-spike-owned": "true"
    }
  },
  "spec": {
    "podSelector": {
      "matchLabels": {
        "app": "nitro-v9-sandbox"
      }
    },
    "policyTypes": [
      "Egress"
    ],
    "egress": [
      {
        "ports": [
          {
            "protocol": "UDP",
            "port": 53
          },
          {
            "protocol": "TCP",
            "port": 53
          }
        ]
      },
      {
        "to": [
          {
            "podSelector": {
              "matchLabels": {
                "app": "stirrup-egress-proxy"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 8080
          }
        ]
      }
    ]
  }
}