{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "nitro-v9-large",
    "namespace": "nitro-spike",
    "labels": {
      "nitro-spike-owned": "true",
      "app": "nitro-v9-sandbox"
    }
  },
  "spec": {
    "runtimeClassName": "isolated-sandbox",
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "activeDeadlineSeconds": 1800,
    "terminationGracePeriodSeconds": 0,
    "nodeSelector": {
      "kubernetes.io/arch": "amd64"
    },
    "securityContext": {
      "fsGroup": 65532
    },
    "volumes": [
      {
        "name": "workspace",
        "emptyDir": {}
      }
    ],
    "containers": [
      {
        "name": "agent",
        "image": "public.ecr.aws/docker/library/golang@sha256:025eefc1e8dbe63201734a72aaa0a55d7a077f2d8410432f8ae2f3e939f32871",
        "command": [
          "/bin/sh",
          "-c",
          "sleep 1800"
        ],
        "workingDir": "/workspace",
        "env": [
          {
            "name": "http_proxy",
            "value": "http://stirrup-egress-proxy.nitro-spike.svc:8080"
          },
          {
            "name": "https_proxy",
            "value": "http://stirrup-egress-proxy.nitro-spike.svc:8080"
          },
          {
            "name": "HTTP_PROXY",
            "value": "http://stirrup-egress-proxy.nitro-spike.svc:8080"
          },
          {
            "name": "HTTPS_PROXY",
            "value": "http://stirrup-egress-proxy.nitro-spike.svc:8080"
          },
          {
            "name": "NO_PROXY",
            "value": ""
          },
          {
            "name": "no_proxy",
            "value": ""
          },
          {
            "name": "HOME",
            "value": "/workspace"
          },
          {
            "name": "GOPATH",
            "value": "/workspace/go"
          },
          {
            "name": "GOMODCACHE",
            "value": "/workspace/modcache"
          },
          {
            "name": "GOCACHE",
            "value": "/workspace/buildcache"
          },
          {
            "name": "GOTOOLCHAIN",
            "value": "local"
          },
          {
            "name": "GIT_TERMINAL_PROMPT",
            "value": "0"
          },
          {
            "name": "GOWORK",
            "value": "off"
          },
          {
            "name": "GOPROXY",
            "value": "https://proxy.golang.org"
          },
          {
            "name": "GOSUMDB",
            "value": "sum.golang.org"
          }
        ],
        "securityContext": {
          "runAsUser": 65532,
          "runAsNonRoot": true,
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "resources": {
          "requests": {
            "cpu": "1",
            "memory": "1Gi",
            "ephemeral-storage": "4Gi"
          },
          "limits": {
            "cpu": "1",
            "memory": "1Gi",
            "ephemeral-storage": "4Gi"
          }
        },
        "volumeMounts": [
          {
            "name": "workspace",
            "mountPath": "/workspace"
          }
        ]
      }
    ]
  }
}